    "@types/yargs": "^17.0.35",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
