  "query": "\n            SELECT\n                member_id,\n                email,\n                first_name,\n                last_name,\n                joined_at,\n                discord_id,\n                discord_username,\n                updated_at,\n                archived_at\n            FROM members\n            WHERE ($1::bool OR archived_at IS NULL)\n              AND member_id > $2\n            ORDER BY member_id\n            LIMIT $3\n            ",
