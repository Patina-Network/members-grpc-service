DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=members
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?sslmode=${DATABASE_SSLMODE}
GRPC_REFLECTION=true
ENABLE_CORE_ADMIN_SERVICE=true
MAX_BULK_OPERATIONS=10000
BULK_OPERATION_TIMEOUT_MS=5000
