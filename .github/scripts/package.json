{
  "name": "scripts",
  "version": "1.0.0",
  "description": "@patina-network/hello-world-grpc-service CI Scripts",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun run prettier && bun run lint",
